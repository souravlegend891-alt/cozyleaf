<script defer>
(function(){
  "use strict";

  var drop = document.getElementById('c2jDrop'),
      input = document.getElementById('c2jInput'),
      settingsBox = document.getElementById('c2jSettings'),
      fileList = document.getElementById('c2jFileList'),
      emptyState = document.getElementById('c2jEmptyState'),
      summary = document.getElementById('c2jSummary'),
      statsEl = document.getElementById('c2jStats'),
      formatToggle = document.getElementById('c2jFormatToggle'),
      formatHint = document.getElementById('c2jFormatHint'),
      qualityWrap = document.getElementById('c2jQualityWrap'),
      qualitySlider = document.getElementById('c2jQuality'),
      qualityVal = document.getElementById('c2jQualityVal'),
      bgWrap = document.getElementById('c2jBgWrap'),
      resizeToggle = document.getElementById('c2jResizeToggle'),
      resizeValue = document.getElementById('c2jResizeValue'),
      targetWrap = document.getElementById('c2jTargetWrap'),
      targetToggle = document.getElementById('c2jTargetToggle'),
      targetValue = document.getElementById('c2jTargetValue'),
      prefixInput = document.getElementById('c2jPrefix'),
      safetyNote = document.getElementById('c2jSafetyNote'),
      convertAllBtn = document.getElementById('c2jConvertAll'),
      downloadAllBtn = document.getElementById('c2jDownloadAll'),
      clearAllBtn = document.getElementById('c2jClearAll'),
      swatches = document.querySelectorAll('.c2j-swatch'),
      customColor = document.getElementById('c2jCustomColor'),
      modal = document.getElementById('c2jModal'),
      modalClose = document.getElementById('c2jModalClose'),
      modalTitle = document.getElementById('c2jModalTitle'),
      modalBefore = document.getElementById('c2jModalBefore'),
      modalAfter = document.getElementById('c2jModalAfter'),
      modalAfterLabel = document.getElementById('c2jModalAfterLabel'),
      modalBeforeMeta = document.getElementById('c2jModalBeforeMeta'),
      modalAfterMeta = document.getElementById('c2jModalAfterMeta');

  var FORMATS = {
    jpg:  { mime:'image/jpeg', ext:'.jpg',  label:'JPG',  lossy:true,  alpha:false,
            hint:"JPG is compressed and best for photos. It doesn't support transparency." },
    png:  { mime:'image/png',  ext:'.png',  label:'PNG',  lossy:false, alpha:true,
            hint:'PNG is lossless and keeps transparency — best for graphics, logos, and screenshots.' },
    webp: { mime:'image/webp', ext:'.webp', label:'WebP', lossy:true,  alpha:true,
            hint:'WebP keeps transparency with strong compression — great for websites.' }
  };
  var outputFormat = 'jpg';

  var entries = [];
  var uid = 0;
  var bgColor = '#FFFFFF';
  var heic2anyLoading = null;
  var jszipLoading = null;

  // Safety limits — protects mobile devices from running out of memory,
  // the same class of problem that ruled out the background-removal tool.
  var MAX_MEGAPIXELS = 24;          // auto-downscale anything larger than this
  var MAX_FILE_SIZE = 60 * 1024 * 1024; // reject files bigger than 60MB outright
  var MAX_BATCH = 40;               // soft cap on how many files can be queued at once

  function fmtBytes(n){
    if (n < 1024) return n + ' B';
    if (n < 1024*1024) return (n/1024).toFixed(n < 10*1024 ? 1 : 0) + ' KB';
    return (n/(1024*1024)).toFixed(2) + ' MB';
  }
  function isHeic(file){
    return /image\/hei[cf]/i.test(file.type) || /\.hei[cf]$/i.test(file.name);
  }
  function canvasToBlob(canvas, mime, quality){
    return new Promise(function(res){ canvas.toBlob(res, mime, quality); });
  }
  function ensureHeic2any(){
    if (window.heic2any) return Promise.resolve();
    if (heic2anyLoading) return heic2anyLoading;
    heic2anyLoading = new Promise(function(resolve, reject){
      var s = document.createElement('script');
      s.src = 'https://cdnjs.cloudflare.com/ajax/libs/heic2any/0.0.1/index.min.js';
      s.onload = resolve; s.onerror = reject;
      document.head.appendChild(s);
    });
    return heic2anyLoading;
  }
  function ensureJSZip(){
    if (window.JSZip) return Promise.resolve();
    if (jszipLoading) return jszipLoading;
    jszipLoading = new Promise(function(resolve, reject){
      var s = document.createElement('script');
      s.src = 'https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js';
      s.onload = resolve; s.onerror = reject;
      document.head.appendChild(s);
    });
    return jszipLoading;
  }

  // ---- Output format toggle ----
  function applyFormatUI(){
    var fmt = FORMATS[outputFormat];
    formatHint.textContent = fmt.hint;
    qualityWrap.style.display = fmt.lossy ? '' : 'none';
    bgWrap.style.display = fmt.alpha ? 'none' : '';
    targetWrap.style.display = fmt.lossy ? '' : 'none';
    if (!fmt.lossy){ targetToggle.checked = false; targetValue.disabled = true; }
  }
  Array.prototype.forEach.call(formatToggle.querySelectorAll('button'), function(btn){
    btn.addEventListener('click', function(){
      var newFormat = btn.dataset.format;
      if (newFormat === outputFormat) return;
      outputFormat = newFormat;
      Array.prototype.forEach.call(formatToggle.querySelectorAll('button'), function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
      applyFormatUI();
      // Previously converted files no longer match the newly selected format —
      // mark them pending again so re-converting applies the new format.
      entries.forEach(function(e){
        if (e.status === 'done'){
          if (e.outUrl) URL.revokeObjectURL(e.outUrl);
          e.status = 'pending'; e.outBlob = null; e.outUrl = null; e.outSize = null;
        }
      });
      renderFileList();
    });
  });
  applyFormatUI();

  swatches.forEach(function(btn){
    btn.addEventListener('click', function(){
      swatches.forEach(function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
      bgColor = btn.dataset.color;
    });
  });
  customColor.addEventListener('input', function(){
    swatches.forEach(function(b){ b.classList.remove('active'); });
    bgColor = customColor.value;
  });

  function showSafetyNote(msg){
    safetyNote.textContent = msg;
    safetyNote.classList.add('show');
  }

  function addFiles(fileArr){
    var candidates = Array.prototype.filter.call(fileArr, function(f){
      return f.type.indexOf('image/') === 0 || isHeic(f);
    });
    if (!candidates.length) return;

    var oversized = candidates.filter(function(f){ return f.size > MAX_FILE_SIZE; });
    var valid = candidates.filter(function(f){ return f.size <= MAX_FILE_SIZE; });

    if (entries.length + valid.length > MAX_BATCH){
      valid = valid.slice(0, Math.max(0, MAX_BATCH - entries.length));
      showSafetyNote('Only the first ' + MAX_BATCH + ' images were added at once, to keep things smooth on mobile. Convert this batch, then add more.');
    } else if (oversized.length){
      showSafetyNote(oversized.length + ' file(s) were skipped — over 60MB is too large to safely convert on a phone.');
    }

    if (!valid.length) return;
    settingsBox.classList.add('show');
    valid.forEach(function(file){
      var id = 'c2j' + (++uid);
      var entry = { id:id, file:file, status:'pending', heic:isHeic(file) };
      entries.push(entry);
      if (!entry.heic){
        var img = new Image();
        img.onload = function(){ entry.w = img.naturalWidth; entry.h = img.naturalHeight; entry.imgEl = img; };
        img.src = URL.createObjectURL(file);
        entry.thumbUrl = img.src;
      } else {
        entry.thumbUrl = null;
      }
      renderFileList();
    });
  }

  drop.addEventListener('click', function(){ input.click(); });
  drop.addEventListener('keydown', function(e){ if (e.key === 'Enter' || e.key === ' '){ e.preventDefault(); input.click(); } });
  input.addEventListener('change', function(){ addFiles(input.files); input.value = ''; });
  ['dragenter','dragover'].forEach(function(evt){ drop.addEventListener(evt, function(e){ e.preventDefault(); drop.classList.add('c2j-drag'); }); });
  ['dragleave','drop'].forEach(function(evt){ drop.addEventListener(evt, function(e){ e.preventDefault(); drop.classList.remove('c2j-drag'); }); });
  drop.addEventListener('drop', function(e){ if (e.dataTransfer.files.length) addFiles(e.dataTransfer.files); });
  document.addEventListener('paste', function(e){
    var items = (e.clipboardData || {}).files;
    if (items && items.length) addFiles(items);
  });

  qualitySlider.addEventListener('input', function(){ qualityVal.textContent = qualitySlider.value; });
  resizeToggle.addEventListener('change', function(){ resizeValue.disabled = !resizeToggle.checked; });
  targetToggle.addEventListener('change', function(){ targetValue.disabled = !targetToggle.checked; });

  modalClose.addEventListener('click', closeModal);
  modal.addEventListener('click', function(e){ if (e.target === modal) closeModal(); });
  function closeModal(){ modal.classList.remove('show'); }
  function openModal(entry){
    modalTitle.textContent = entry.file.name;
    modalBefore.src = entry.thumbUrl || '';
    modalBeforeMeta.innerHTML = '<b>' + fmtBytes(entry.file.size) + '</b>' + (entry.w ? (entry.w + '×' + entry.h) : '');
    modalAfterLabel.textContent = FORMATS[outputFormat].label;
    if (entry.status === 'done'){
      modalAfter.src = entry.outUrl;
      modalAfterMeta.innerHTML = '<b>' + fmtBytes(entry.outSize) + '</b>' + FORMATS[outputFormat].label;
    } else {
      modalAfter.src = entry.thumbUrl || '';
      modalAfterMeta.innerHTML = '<b>—</b>Not converted yet';
    }
    modal.classList.add('show');
  }

  function drawToCanvas(imgEl){
    var w = imgEl.naturalWidth || imgEl.width, h = imgEl.naturalHeight || imgEl.height;
    if (resizeToggle.checked){
      var maxDim = parseInt(resizeValue.value, 10) || 1920;
      var longest = Math.max(w, h);
      if (longest > maxDim){ var scale = maxDim / longest; w = Math.round(w*scale); h = Math.round(h*scale); }
    }
    // Hard safety cap, independent of the user's own resize setting — keeps
    // canvas memory bounded so a huge photo can't stall or crash a phone.
    var megapixels = (w * h) / 1e6;
    if (megapixels > MAX_MEGAPIXELS){
      var safeScale = Math.sqrt(MAX_MEGAPIXELS / megapixels);
      w = Math.round(w * safeScale); h = Math.round(h * safeScale);
      showSafetyNote('One or more very large photos were automatically scaled down a bit to keep conversion smooth on your device.');
    }
    var canvas = document.createElement('canvas');
    canvas.width = w; canvas.height = h;
    var ctx = canvas.getContext('2d');
    var fmt = FORMATS[outputFormat];
    if (!fmt.alpha){
      // JPG has no transparency channel — fill with the chosen background first.
      ctx.fillStyle = bgColor;
      ctx.fillRect(0, 0, w, h);
    }
    ctx.drawImage(imgEl, 0, 0, w, h);
    return canvas;
  }

  // Binary-searches quality (bounded to 6 tries) to land close to a
  // requested output size in KB, for lossy formats only. All work stays
  // on-canvas — no extra libraries needed.
  function encodeToTarget(canvas){
    var fmt = FORMATS[outputFormat];
    var baseQ = qualitySlider.value / 100;
    if (!fmt.lossy){
      return canvasToBlob(canvas, fmt.mime, undefined);
    }
    var targetBytes = (targetToggle.checked ? (parseInt(targetValue.value, 10) || 200) : 0) * 1024;
    if (!targetBytes){
      return canvasToBlob(canvas, fmt.mime, baseQ);
    }
    var lo = 0.1, hi = 0.98, tries = 0, bestBlob = null;
    function step(){
      var q = (lo + hi) / 2;
      return canvasToBlob(canvas, fmt.mime, q).then(function(blob){
        tries++;
        if (!bestBlob || Math.abs(blob.size - targetBytes) < Math.abs(bestBlob.size - targetBytes)) bestBlob = blob;
        if (tries >= 6) return bestBlob;
        if (blob.size > targetBytes) hi = q; else lo = q;
        return step();
      });
    }
    return step();
  }

  function convertEntry(entry){
    return new Promise(function(resolve){
      entry.status = 'converting';
      renderFileList();

      function finishWithImage(imgEl){
        var canvas = drawToCanvas(imgEl);
        encodeToTarget(canvas).then(function(blob){
          entry.outBlob = blob;
          entry.outSize = blob.size;
          entry.outUrl = URL.createObjectURL(blob);
          entry.status = 'done';
          renderFileList();
          resolve();
        });
      }

      if (entry.heic){
        ensureHeic2any().then(function(){
          return window.heic2any({ blob: entry.file, toType: 'image/png', quality: 0.92 });
        }).then(function(pngBlob){
          var img = new Image();
          img.onload = function(){
            entry.thumbUrl = img.src;
            entry.w = img.naturalWidth; entry.h = img.naturalHeight;
            finishWithImage(img);
          };
          img.onerror = function(){ entry.status = 'error'; renderFileList(); resolve(); };
          img.src = URL.createObjectURL(pngBlob);
        }).catch(function(){
          entry.status = 'error';
          renderFileList();
          resolve();
        });
      } else {
        var tick = function(){
          if (!entry.imgEl || !entry.imgEl.complete){ setTimeout(tick, 30); return; }
          finishWithImage(entry.imgEl);
        };
        tick();
      }
    });
  }

  convertAllBtn.addEventListener('click', function(){
    convertAllBtn.disabled = true;
    var pending = entries.filter(function(e){ return e.status !== 'converting' && e.status !== 'done'; });
    var total = pending.length, done = 0;
    if (!total){ convertAllBtn.disabled = false; return; }
    convertAllBtn.textContent = 'Converting 0 of ' + total + '…';
    var chain = pending.reduce(function(p, entry){
      return p.then(function(){
        return convertEntry(entry).then(function(){
          done++;
          convertAllBtn.textContent = 'Converting ' + done + ' of ' + total + '…';
        });
      });
    }, Promise.resolve());
    chain.then(function(){
      convertAllBtn.disabled = false;
      convertAllBtn.textContent = 'Convert all';
      updateSummary();
    });
  });

  clearAllBtn.addEventListener('click', function(){
    entries.forEach(function(e){ if (e.outUrl) URL.revokeObjectURL(e.outUrl); });
    entries = [];
    settingsBox.classList.remove('show');
    safetyNote.classList.remove('show');
    renderFileList();
  });

  function safePrefix(){
    return (prefixInput.value || '').replace(/[^a-zA-Z0-9\-_ ]/g, '').trim();
  }
  function outputFileName(entry){
    var base = entry.file.name.replace(/\.[^.]+$/, '');
    var p = safePrefix();
    return (p ? p + base : base) + FORMATS[outputFormat].ext;
  }

  function renderFileList(){
    fileList.innerHTML = '';
    emptyState.hidden = entries.length > 0;
    updateSummary();

    entries.forEach(function(entry){
      var li = document.createElement('li');
      li.className = 'c2j-file';

      var thumb = document.createElement('img');
      thumb.className = 'c2j-file-thumb';
      thumb.src = entry.thumbUrl || 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="44" height="44"><rect width="44" height="44" fill="%23EFEAE1"/></svg>';
      thumb.alt = '';
      thumb.addEventListener('click', function(){ openModal(entry); });
      li.appendChild(thumb);

      var mid = document.createElement('div');
      var name = document.createElement('p');
      name.className = 'c2j-file-name';
      name.textContent = entry.file.name;
      mid.appendChild(name);

      var meta = document.createElement('div');
      meta.className = 'c2j-file-meta';
      var fromExt = (entry.file.name.split('.').pop() || 'img').toUpperCase().slice(0,4);
      var toLabel = FORMATS[outputFormat].label;
      var swapHtml = '<span class="c2j-badge-swap">' + fromExt + ' → ' + (entry.status === 'done' ? '<span class="c2j-badge-to">' + toLabel + '</span>' : toLabel) + '</span>';
      if (entry.status === 'done'){
        meta.innerHTML = swapHtml + '<span>' + fmtBytes(entry.outSize) + '</span>';
      } else if (entry.status === 'converting'){
        meta.innerHTML = swapHtml + '<span class="c2j-pending">Converting…</span>';
      } else if (entry.status === 'error'){
        meta.innerHTML = swapHtml + '<span class="c2j-error">Couldn\u2019t read this file</span>';
      } else {
        meta.innerHTML = swapHtml + '<span class="c2j-pending">Waiting</span>';
      }
      mid.appendChild(meta);
      li.appendChild(mid);

      var actions = document.createElement('div');
      actions.className = 'c2j-file-actions';

      if (navigator.clipboard && window.ClipboardItem){
        var copyBtn = document.createElement('button');
        copyBtn.className = 'c2j-icon-btn copy' + (entry.status === 'done' ? ' ready' : '');
        copyBtn.type = 'button';
        copyBtn.setAttribute('aria-label', 'Copy to clipboard');
        copyBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>';
        if (entry.status === 'done'){
          copyBtn.addEventListener('click', function(){
            navigator.clipboard.write([ new ClipboardItem({ mimeTypeOf: entry.outBlob }) ]).catch(function(){});
            var item = {};
            item[FORMATS[outputFormat].mime] = entry.outBlob;
            navigator.clipboard.write([ new ClipboardItem(item) ])
              .then(function(){
                copyBtn.classList.add('done');
                setTimeout(function(){ copyBtn.classList.remove('done'); }, 1500);
              })
              .catch(function(){ /* clipboard image write unsupported in this browser — download still works */ });
          });
        }
        actions.appendChild(copyBtn);
      }

      var dlBtn = document.createElement('a');
      dlBtn.className = 'c2j-icon-btn dl' + (entry.status === 'done' ? ' ready' : '');
      dlBtn.setAttribute('aria-label', 'Download');
      dlBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v13m0 0l-5-5m5 5l5-5M4 21h16"/></svg>';
      if (entry.status === 'done'){
        dlBtn.href = entry.outUrl;
        dlBtn.download = outputFileName(entry);
      }
      actions.appendChild(dlBtn);
      li.appendChild(actions);

      fileList.appendChild(li);
    });
  }

  function updateSummary(){
    var done = entries.filter(function(e){ return e.status === 'done'; });
    if (done.length){ summary.classList.add('show'); } else { summary.classList.remove('show'); }
    document.getElementById('c2jDoneCount').textContent = done.length;

    if (!done.length){ statsEl.innerHTML = ''; return; }
    var origTotal = done.reduce(function(s,e){ return s + e.file.size; }, 0);
    var outTotal = done.reduce(function(s,e){ return s + e.outSize; }, 0);
    var savedPct = origTotal > 0 ? Math.round((1 - (outTotal / origTotal)) * 100) : 0;
    var savedHtml = '';
    if (savedPct > 0){
      savedHtml = '<span class="save">↓ ' + savedPct + '% smaller</span>';
    } else if (savedPct < 0){
      savedHtml = '<span>↑ ' + Math.abs(savedPct) + '% larger</span>';
    }
    statsEl.innerHTML =
      '<span>Original: <b>' + fmtBytes(origTotal) + '</b></span>' +
      '<span>Converted: <b>' + fmtBytes(outTotal) + '</b></span>' +
      savedHtml;
  }

  downloadAllBtn.addEventListener('click', function(){
    var done = entries.filter(function(e){ return e.status === 'done'; });
    if (!done.length) return;
    downloadAllBtn.disabled = true;
    var original = downloadAllBtn.textContent;
    downloadAllBtn.textContent = 'Zipping…';
    ensureJSZip().then(function(){
      var zip = new window.JSZip();
      done.forEach(function(e){ zip.file(outputFileName(e), e.outBlob); });
      return zip.generateAsync({ type: 'blob' });
    }).then(function(blob){
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'cozyleaf-converted-images.zip';
      document.body.appendChild(a); a.click(); a.remove();
      downloadAllBtn.disabled = false; downloadAllBtn.textContent = original;
    }).catch(function(){
      downloadAllBtn.disabled = false; downloadAllBtn.textContent = original;
      alert('Could not build the ZIP — please try downloading images individually.');
    });
  });

})();
</script>
</body>
